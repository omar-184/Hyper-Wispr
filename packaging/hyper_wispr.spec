# PyInstaller spec. Build with:  pyinstaller packaging/hyper_wispr.spec
# The NVIDIA CUDA libraries are not bundled: the app downloads them on PCs that can use them
# (hyper_wispr/gpu_pack.py). Run packaging/gpu_manifest.py first so gpu_pack.json is included.
import os

from PyInstaller.utils.hooks import collect_data_files, collect_dynamic_libs, collect_submodules

ROOT = os.path.abspath(os.path.join(SPECPATH, ".."))

datas = collect_data_files("faster_whisper") + collect_data_files("onnxruntime")
binaries = collect_dynamic_libs("ctranslate2") + collect_dynamic_libs("onnxruntime") + collect_dynamic_libs("sounddevice")
# The built-in AI cleanup engine: llama.dll and the ggml DLLs it loads from llama_cpp/lib.
binaries += collect_dynamic_libs("llama_cpp")
datas += collect_data_files("_sounddevice_data")
datas += collect_data_files("hyper_wispr")  # the Settings window's web/ files
# Added from the source folder: it's written after `pip install .`, so the installed copy lacks it.
GPU_PACK = os.path.join(ROOT, "hyper_wispr", "gpu_pack.json")
if not os.path.isfile(GPU_PACK):
    raise SystemExit("Run packaging/gpu_manifest.py first: hyper_wispr/gpu_pack.json is missing")
datas.append((GPU_PACK, "hyper_wispr"))
datas += collect_data_files("webview")
hiddenimports = (
    collect_submodules("hyper_wispr")
    + collect_submodules("pynput")
    + collect_submodules("pystray")
    # comtypes.gen holds the UI Automation wrapper, generated by the build step before this runs.
    + collect_submodules("comtypes")
    + collect_submodules("pycaw")
    + ["webview.platforms.edgechromium", "webview.platforms.winforms", "clr"]
    + ["ctranslate2", "onnxruntime", "av"]
    + collect_submodules("llama_cpp", filter=lambda name: ".server" not in name)
)

a = Analysis(
    [os.path.join(SPECPATH, "launcher.py")],
    pathex=[ROOT],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    excludes=["tkinter", "matplotlib", "IPython", "pytest"],
)
pyz = PYZ(a.pure)
exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="Hyper-Wispr",
    console=False,
    icon=os.path.join(SPECPATH, "icon.ico"),
)
coll = COLLECT(exe, a.binaries, a.datas, name="Hyper-Wispr")
